{
  "schemaVersion": "1.1",
  "id": "verify-and-file-dispute",
  "name": "Verify And File Dispute",
  "description": "Look up a member dispute, verify the transaction amount, and file it.",
  "version": 1,
  "app": {
    "vendorId": "relay-core",
    "surfaceKind": "legacy-web"
  },
  "auth": {
    "credentialRef": "vault://tenant-9/teller"
  },
  "approval": {
    "requestedBy": "analyst@relay",
    "approvedBy": "risk@relay",
    "approvedAt": "2026-09-10T17:00:00.000Z"
  },
  "parameters": [
    {
      "name": "memberId",
      "type": "string",
      "description": "Member number or name."
    },
    {
      "name": "merchant",
      "type": "string",
      "description": "Merchant on the queue row to open."
    },
    {
      "name": "last4",
      "type": "string",
      "description": "Card last 4 on the queue row to open."
    },
    {
      "name": "reason",
      "type": "string",
      "description": "Filing reason shown on the form."
    }
  ],
  "outputs": [
    {
      "name": "transactionAmount",
      "type": "money",
      "pii": true,
      "description": "Amount displayed on the dispute detail before filing.",
      "locator": {
        "primary": {
          "by": "role",
          "role": "cell",
          "name": "Transaction Amount"
        },
        "fallbacks": [
          {
            "by": "label",
            "name": "Transaction Amount"
          },
          {
            "by": "text",
            "text": "Transaction Amount"
          },
          {
            "by": "css",
            "selector": "[aria-label=\"Transaction Amount\"]"
          }
        ]
      }
    },
    {
      "name": "confirmation",
      "type": "string",
      "pii": true,
      "description": "Confirmation text after the dispute is filed.",
      "locator": {
        "primary": {
          "by": "role",
          "role": "status",
          "name": "Confirmation"
        },
        "fallbacks": [
          {
            "by": "label",
            "name": "Confirmation"
          },
          {
            "by": "text",
            "text": "Confirmation"
          },
          {
            "by": "css",
            "selector": "[aria-label=\"Confirmation\"]"
          }
        ]
      }
    }
  ],
  "sideEffects": {
    "kind": "irreversible",
    "compensation": "Teller withdraws the case from the dispute queue in the core. Automation cannot un-file a Confirm."
  },
  "preconditions": {
    "requiresSession": true,
    "requiresRole": "teller",
    "entryCheckpoint": {
      "kind": "textIncludes",
      "expect": "Savings Balance"
    }
  },
  "uses": [
    {
      "capabilityId": "lookup-member-savings",
      "pass": [
        "memberId"
      ]
    }
  ],
  "provenance": {
    "discoveredAt": "2026-09-10T05:12:30.346Z",
    "discoveredBy": "model",
    "model": "gpt-4o",
    "promptHash": "1539c4549b8e7515bfe86e62067d67b27ce52764cda8c6f8922e8b7293c3ea24",
    "evidenceRunId": "discovery-verify-and-file-dispute",
    "goal": "Jane Doe called about an unauthorized charge from ACME POS on her card ending 4412. Find that transaction, verify the amount, and file it as Unauthorized."
  },
  "idempotencyKeyFrom": [
    "memberId",
    "merchant",
    "last4"
  ],
