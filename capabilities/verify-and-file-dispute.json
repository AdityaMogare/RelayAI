      "detect": {
        "textIncludes": "Member not found"
      },
      "classify": "business_outcome",
      "code": "MEMBER_NOT_FOUND",
      "message": "No member record matches the supplied ID."
    },
    {
      "detect": {
        "textIncludes": "Permission denied"
      },
      "classify": "business_outcome",
      "code": "PERMISSION_DENIED",
      "message": "The operator is not authorized to view this member."
    },
    {
      "detect": {
        "textIncludes": "Member ID is required"
      },
      "classify": "business_outcome",
      "code": "VALIDATION_ERROR",
      "message": "The form rejected the input."
    },
    {
      "detect": {
        "dialogTitle": "System Notice"
