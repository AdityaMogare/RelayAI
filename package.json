{
  "name": "relayai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Computer-use automation: LLM discovers a flow, then deterministic replay invokes it.",
  "scripts": {
    "console": "tsx apps/bank-console/server.ts",
    "discover": "tsx src/cli.ts discover",
    "rediscover": "tsx src/cli.ts rediscover",
    "replay": "tsx src/cli.ts replay",
    "escalate-demo": "tsx src/cli.ts escalate-demo",
    "capabilities": "tsx src/cli.ts capabilities",
    "stability": "tsx src/cli.ts stability",
    "verify": "tsx src/cli.ts verify",
    "evidence": "tsx scripts/generate-evidence.ts",
    "evidence:purge": "tsx src/cli.ts evidence-purge",
    "audit": "tsx src/cli.ts audit",
    "review": "tsx src/cli.ts review",
    "kill": "tsx src/cli.ts kill",
    "approve": "tsx src/cli.ts approve",
    "probe": "tsx src/cli.ts probe",
    "overlay": "tsx src/cli.ts overlay",
    "drift": "tsx src/cli.ts drift",
    "portability": "tsx src/cli.ts portability",
    "desktop-replay": "tsx src/cli.ts desktop-replay",
    "docker:smoke": "sh scripts/docker-smoke.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "openai": "^4.85.4",
    "playwright": "^1.50.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
