# Required for live discovery (one of these).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides.
# RELAY_LLM_PROVIDER=openai   # anthropic | openai
# RELAY_MODEL=gpt-4o
# RELAY_CONSOLE_PORT=3000
# RELAY_OPERATOR_PORT=3847
# RELAY_BIND_HOST=127.0.0.1      # 0.0.0.0 in Docker so the host can reach the console
# RELAY_HEADED=1                 # show the browser during discover/replay
# RELAY_AUTO_RESUME_MS=8000      # escalate-demo: auto-resume after N ms (CI / evidence)

# Credential vault — resolved at replay, never written to artifacts or evidence.
# RELAY_VAULT_tenant_9_teller=teller01:relay-teller-9
# RELAY_INTERVENTION_TTL_MS=120000  # unattended escalation → abandoned + session released
# RELAY_OPERATOR_ID=teller01     # default operator identity on the claim form
